<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Amigo</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Editar Amigo</h1>
    <div class="form-card">
        <form action="/amigos/editar/<%= amigo.id %>" method="POST">
            <label>Nome:</label>
            <input name="nome" value="<%= amigo.nome %>" required />
            
            <label>Email:</label>
            <input name="email" value="<%= amigo.email %>" required />

            <button type="submit" style="background-color: #7c4dff;">Salvar Alterações</button>
            <a href="/amigos" style="margin-left: 15px;">Cancelar</a>
        </form>
    </div>
</body>
</html>