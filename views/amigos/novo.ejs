<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Novo Amigo</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Novo Amigo</h1>
    <div class="form-card">
        <form action="/amigos/novo" method="POST">
            <label>Nome:</label>
            <input name="nome" required />
            
            <label>Email:</label>
            <input name="email" required />

            <button type="submit" style="background-color: #7c4dff;">Salvar Amigo</button>
            <a href="/amigos" style="margin-left: 15px;">Cancelar</a>
        </form>
    </div>
</body>
</html>