<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Novo Empréstimo</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Registrar Empréstimo</h1>
    <div class="form-card">
        <form action="/emprestimos/novo" method="POST">
            <label>Jogo:</label>
            <select name="jogoId" required>
                <% jogos.forEach(j => { %>
                    <option value="<%= j.id %>"><%= j.titulo %></option>
                <% }) %>
            </select>

            <label>Amigo que pegou:</label>
            <select name="amigoId" required>
                <% amigos.forEach(a => { %>
                    <option value="<%= a.id %>"><%= a.nome %></option>
                <% }) %>
            </select>

            <label>Data de início:</label>
            <input name="dataInicio" placeholder="AAAA-MM-DD" required />

            <label>Data de fim (opcional):</label>
            <input name="dataFim" placeholder="AAAA-MM-DD" />

            <button type="submit" style="background-color: #7c4dff;">Salvar Empréstimo</button>
            <a href="/emprestimos" style="margin-left: 15px;">Cancelar</a>
        </form>
    </div>
</body>
</html>